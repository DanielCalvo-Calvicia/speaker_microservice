# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=Speaker Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8003
LOG_LEVEL=INFO
# Required: bearer token clients must send to every route except /health
# Comma-separated CORS origins
ALLOWED_ORIGINS=*
# Leave blank to auto-detect an output device from the keywords below
SPEAKER_DEVICE_INDEX=
SPEAKER_DEVICE_KEYWORDS=i2s,hw,default,sysdefault
# Optional: URL of an audio stream to keep playing (reconnects with backoff)
